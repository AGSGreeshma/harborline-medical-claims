# Copy to .env and adjust. Leave values empty to use the defaults shown in comments.
# Nothing here is a secret - everything runs locally.

# Ollama (local LLM). Default: http://localhost:11434
OLLAMA_URL=
# Default: qwen2.5:3b   (use qwen2.5:7b for higher accuracy on a bigger machine)
OLLAMA_MODEL=
# Seconds to wait for the model. Default: 120
OLLAMA_TIMEOUT=
# 1 = skip the LLM and use the deterministic extractor only (useful in CI). Default: 0
DISABLE_LLM=

# spaCy model used by Presidio. Default: en_core_web_lg if installed, else en_core_web_sm
SPACY_MODEL=

# Hospital-bill limit in rupees. Default: 50000
BILL_LIMIT=

# Low-quality scan thresholds. Defaults: 40 characters, mean confidence 60
MIN_OCR_CHARS=
MIN_OCR_CONFIDENCE=

# Upload limits. Defaults: 10 MB, 5 pages
MAX_UPLOAD_MB=
MAX_PAGES=

# Print OpenTelemetry spans to the console (1/0). Default: 0
OTEL_CONSOLE=
